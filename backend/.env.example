PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maktab_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=change_this_super_secret_key_min_32chars
JWT_REFRESH_SECRET=change_this_refresh_secret_key_min_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin (server ishga tushganda shu login/parol bilan avtomatik yaratiladi/yangilanadi)
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=change_this_to_a_strong_password
SUPERADMIN_FULL_NAME=Bosh Administrator

# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_LAT=41.9579
OPENWEATHER_LON=60.3592

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CLIENT_URL=http://localhost:5173

# ===== AI / RAG CHATBOT =====
# Google Gen AI (Gemini) kaliti — embedding va javob generatsiyasi uchun
GEMINI_API_KEY=your_gemini_api_key

# Embedding modeli va o'lchovi.
# DIQQAT: o'lchov migrations/008_pgvector.sql dagi vector(N) bilan bir xil bo'lishi shart.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768

# Javob generatsiyasi modeli (Faza 2)
GEMINI_CHAT_MODEL=gemini-3.7-flash

# 1 mln token uchun narx (AQSh dollarida) — xarajat hisobi uchun
GEMINI_INPUT_PRICE_PER_1M=0.75
GEMINI_OUTPUT_PRICE_PER_1M=3.75
GEMINI_EMBEDDING_PRICE_PER_1M=0

# Oylik byudjet chegarasi. Chegara oshsa AI chaqiruvlari to'xtaydi (0 = chegarasiz)
AI_MONTHLY_BUDGET_USD=30

# Kontekst "yetarli" deb hisoblanadigan minimal o'xshashlik (0..1).
# O'lchov asosida tanlangan — scripts/chatbot-quality.ts ni ishlatib qayta sozlang.
CHATBOT_MIN_SIMILARITY=0.64

# Bitta IP uchun 15 daqiqada ruxsat etilgan savollar soni
CHATBOT_RATE_LIMIT=20

# Suhbat tarixi necha kun saqlanadi (keyin avtomatik o'chiriladi)
CHAT_RETENTION_DAYS=90

# IP manzilini hashlash uchun tuz (bo'sh bo'lsa JWT_SECRET ishlatiladi)
IP_HASH_SALT=
