PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maktab_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=change_this_super_secret_key_min_32chars
JWT_REFRESH_SECRET=change_this_refresh_secret_key_min_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_LAT=41.9579
OPENWEATHER_LON=60.3592

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CLIENT_URL=http://localhost:5173
